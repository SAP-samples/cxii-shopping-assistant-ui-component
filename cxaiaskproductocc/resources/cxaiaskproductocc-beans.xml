<beans xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="beans.xsd">

	<bean class="com.sap.cxai.askproduct.ConsumedDestinationData">
		<property name="url" type="String"/>
		<property name="authUrl" type="String"/>
		<property name="clientId" type="String"/>
		<property name="clientSecret" type="String"/>
	</bean>

	<bean class="com.sap.cxai.CxaiConfigData">
		<property name="askProductDestination" type="com.sap.cxai.askproduct.ConsumedDestinationData"/>
		<property name="askProductContextMessageWindow" type="Integer"/>
		<property name="askProductContextCharacterLimit" type="Integer"/>
		
		<property name="assistantDestination" type="com.sap.cxai.askproduct.ConsumedDestinationData"/>
		<property name="assistantConfigId" type="String"/>
		<property name="assistantProductFiltersJson" type="String"/>
		<property name="collapseVariantCategories" type="java.util.List&lt;String&gt;"/>

	</bean>
	
	<bean class="com.sap.cxai.askproduct.ConsumedDestinationWsDTO">
		<property name="url" type="String"/>
		<property name="authUrl" type="String"/>
		<property name="clientId" type="String"/>
	</bean>

	<bean class="com.sap.cxai.CxaiConfigWsDTO">
		<property name="askProductDestination" type="com.sap.cxai.askproduct.ConsumedDestinationWsDTO"/>
		<property name="askProductContextMessageWindow" type="Integer"/>
		<property name="askProductContextCharacterLimit" type="Integer"/>
		
		<property name="assistantDestination" type="com.sap.cxai.askproduct.ConsumedDestinationWsDTO"/>
		<property name="assistantConfigId" type="String"/>
		<property name="assistantProductFiltersJson" type="String"/>
		<property name="collapseVariantCategories" type="java.util.List&lt;String&gt;"/>

	</bean>
</beans>
