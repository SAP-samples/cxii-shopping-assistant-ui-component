{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "schematics": {
    "@schematics/angular:component": {
      "style": "scss"
    }
  },
  "projects": {
    "cxai-assistant": {
      "projectType": "library",
      "root": "projects/cxai-assistant",
      "sourceRoot": "projects/cxai-assistant/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/cxai-assistant/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/cxai-assistant/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/cxai-assistant/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/cxai-assistant/tsconfig.spec.json",
            "karmaConfig": "karma.conf.js",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ]
          }
        }
      }
    },
    "cxai-ask-product": {
      "projectType": "library",
      "root": "projects/cxai-ask-product",
      "sourceRoot": "projects/cxai-ask-product/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/cxai-ask-product/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/cxai-ask-product/tsconfig.lib.prod.json"
            },
            "production-no-spartacus": {
              "tsConfig": "projects/cxai-ask-product/tsconfig.lib.prod.json",
              "project": "projects/cxai-ask-product/ng-package-no-spartacus.json"
            },
            "development": {
              "tsConfig": "projects/cxai-ask-product/tsconfig.lib.json"
            },
            "development-no-spartacus": {
              "tsConfig": "projects/cxai-ask-product/tsconfig.lib.json",
              "project": "projects/cxai-ask-product/ng-package-no-spartacus.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/cxai-ask-product/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ]
          }
        }
      }
    },
    "web-component": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "skipTests": true
        },
        "@schematics/angular:class": {
          "skipTests": true
        },
        "@schematics/angular:directive": {
          "skipTests": true
        },
        "@schematics/angular:guard": {
          "skipTests": true
        },
        "@schematics/angular:interceptor": {
          "skipTests": true
        },
        "@schematics/angular:pipe": {
          "skipTests": true
        },
        "@schematics/angular:resolver": {
          "skipTests": true
        },
        "@schematics/angular:service": {
          "skipTests": true
        }
      },
      "root": "projects/web-component",
      "sourceRoot": "projects/web-component/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/web-component",
            "index": "projects/web-component/src/index.html",
            "browser": "projects/web-component/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/web-component/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "styles": [],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "50kB",
                  "maximumError": "100kB"
                }
              ],
              "outputHashing": "none",
              "optimization": true,
              "extractLicenses": false,
              "sourceMap": false,
              "namedChunks": false
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "outputHashing": "none",
              "namedChunks": false
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "web-component:build:production"
            },
            "development": {
              "buildTarget": "web-component:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n"
        }
      }
    },
    "spartacus-adapters": {
      "projectType": "library",
      "root": "projects/spartacus-adapters",
      "sourceRoot": "projects/spartacus-adapters/src",
      "prefix": "lib",
      "architect": {
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/spartacus-adapters/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ]
          }
        }
      }
    }
  }
}
