{
  "name": "cxai-ask-product-angular-lib",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",

    "prestart": "npm run sync:all",
    "start": "ng serve",

    "sync:ask-product": "cpx \"projects/spartacus-adapters/src/lib/**/*\" projects/cxai-ask-product/root/spartacus-adapters",
    "sync:all": "npm run sync:ask-product",

    "prebuild-lib": "npm run sync:all",
    "build-lib": "ng build cxai-ask-product --configuration production",

    "prebuild-lib-no-spartacus": "npm run sync:all",
    "build-lib-no-spartacus": "ng build cxai-ask-product --configuration production-no-spartacus",

    "watch-lib": "concurrently \"npm run sync:all -- --watch\" \"ng build cxai-ask-product --watch --configuration development\"",
    "watch-lib-no-spartacus": "concurrently \"npm run sync:all -- --watch\" \"ng build cxai-ask-product --watch --configuration development-no-spartacus\"",

    "build-web-component": "npm run build-lib-no-spartacus && ng build web-component --stats-json --configuration production",
    "pretest": "npm run sync:all",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^19.2.15",
    "@angular/compiler": "^19.2.15",
    "@angular/core": "^19.2.15",
    "@angular/elements": "^19.2.15",
    "@angular/platform-browser": "^19.2.15",
    "@spartacus/core": "221121.4.0",
    "@spartacus/storefront": "221121.4.0",
    "rxjs": "~7.8.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.15",
    "@angular/cli": "^19.2.15",
    "@angular/compiler-cli": "^19.2.15",
    "@types/jasmine": "~5.1.0",
    "concurrently": "^9.2.1",
    "cpx": "^1.5.0",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^19.0.0",
    "ng-samurai": "^3.0.0",
    "typescript": "~5.8.3"
  }
}
